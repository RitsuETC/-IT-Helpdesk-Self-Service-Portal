DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Set false hanya untuk PostgreSQL lokal tanpa SSL.
DATABASE_SSL=true
JWT_SECRET=ganti-dengan-random-secret-yang-panjang
PORT=5000
# Daftar origin frontend; pisahkan dengan koma jika memakai beberapa host.
FRONTEND_URL=http://localhost:5173
# Contoh origin tambahan frontend production/staging:
# CORS_ORIGINS=https://helpdesk.example.com,https://helpdesk-preview.example.com
